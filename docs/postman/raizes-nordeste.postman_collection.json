{
  "info": {
    "name": "Raízes do Nordeste - Fluxo de pedidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastrar usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nome\":\"Cliente Postman\",\"email\":\"cliente-postman@raizes.local\",\"senha\":\"segredo123\"}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login e salvar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login realizado', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"cliente-postman@raizes.local\",\"senha\":\"segredo123\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Sem token - deve retornar 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"canalPedido\":\"APP\",\"itens\":[]}"
            },
            "url": "{{baseUrl}}/api/pedidos"
          }
        },
        {
          "name": "Criar pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Pedido criado', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('pedidoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"canalPedido\":\"TOTEM\",\"itens\":[{\"produtoId\":{{produtoId}},\"quantidade\":1,\"precoUnitario\":15}]}"
            },
            "url": "{{baseUrl}}/api/pedidos"
          }
        },
        {
          "name": "Listar por canal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos?canalPedido=TOTEM"
          }
        },
        {
          "name": "Pagamento mock aprovado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"formaPagamento\":\"PIX\",\"status\":\"APROVADO\",\"payload\":{\"transacao\":\"mock-123\"}}"
            },
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/pagamento-mock"
          }
        }
      ]
    }
  ]
}
